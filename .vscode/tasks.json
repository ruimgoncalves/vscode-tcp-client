{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "dependsOn": ["npm: compile:host", "npm: compile:webview"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "watch",
      "dependsOn": ["npm: watch:host", "npm: watch:webview"],
      "group": { "kind": "build" },
      "problemMatcher": []
    },
    {
      "type": "npm",
      "script": "compile:host",
      "problemMatcher": ["$tsc"],
      "presentation": { "reveal": "silent" }
    },
    {
      "type": "npm",
      "script": "compile:webview",
      "problemMatcher": ["$tsc"],
      "presentation": { "reveal": "silent" }
    },
    {
      "type": "npm",
      "script": "watch:host",
      "problemMatcher": ["$tsc-watch"],
      "isBackground": true,
      "presentation": { "reveal": "never" }
    },
    {
      "type": "npm",
      "script": "watch:webview",
      "problemMatcher": ["$tsc-watch"],
      "isBackground": true,
      "presentation": { "reveal": "never" }
    }
  ]
}
