{
  "name": "vscode-tcp-client",
  "displayName": "TCP Client",
  "description": "Send and receive TCP messages from VS Code with escape-sequence support",
  "version": "0.2.0",
  "publisher": "ruigoncalves",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "keywords": ["tcp", "network", "socket", "client"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tcpClient.openPanel",
        "title": "TCP Client: Open Panel",
        "icon": "$(plug)"
      }
    ],
    "configuration": {
      "title": "TCP Client",
      "properties": {
        "tcpClient.envelopes.custom": {
          "type": "array",
          "default": [],
          "description": "User-defined message envelopes. Each entry: { id, label, prefix, suffix, segmentSeparator, lineMode, lineSeparator } where prefix/suffix/lineSeparator are escape-sequence strings (\\\\xHH, \\\\n, \\\\r, \\\\t, \\\\\\\\, \\\\0) and lineMode is 'none' (default; wrap whole payload once) or 'each-line' (split on lineSeparator and wrap each chunk independently).",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "prefix": { "type": "string", "default": "" },
              "suffix": { "type": "string", "default": "" },
              "segmentSeparator": { "type": "string", "default": "" },
              "lineMode": { "type": "string", "enum": ["none", "each-line"], "default": "none", "description": "How the envelope is applied: 'none' wraps the whole payload once; 'each-line' splits on lineSeparator and wraps each chunk independently." },
              "lineSeparator": { "type": "string", "default": "\\n", "description": "Escape-sequence string used to split the payload when lineMode is 'each-line'. Defaults to \\\\n." }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^2.24.0",
    "eslint": "^8.56.0",
    "mocha": "^10.3.0",
    "typescript": "^5.3.3"
  }
}
