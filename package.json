{
  "name": "vscode-tcp-client",
  "displayName": "TCP Client",
  "description": "Send and receive TCP messages from VS Code with escape-sequence support",
  "version": "0.1.0",
  "publisher": "ruigoncalves",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "keywords": ["tcp", "network", "socket", "client"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tcpClient.openPanel",
        "title": "TCP Client: Open Panel",
        "icon": "$(plug)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vscode/test-electron": "^2.3.8",
    "@vscode/vsce": "^2.24.0",
    "eslint": "^8.56.0",
    "mocha": "^10.3.0",
    "typescript": "^5.3.3"
  }
}
